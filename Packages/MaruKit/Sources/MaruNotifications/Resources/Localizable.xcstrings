{
  "sourceLanguage" : "en",
  "strings" : {
    "%@: %@" : {
      "comment" : "One line of a reminder for a Family with several members. The first placeholder is the member, the second is the list of the items of that member. Example: “Mochi: Methimazole and Flea Drops”. Each language chooses its own colon.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@：%@"
          }
        }
      }
    },
    "%lld more" : {
      "comment" : "The last entry of a list of item names in a reminder, for example “Zinc, Creatine, and 2 more”. The placeholder is the number of items not named.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld weitere"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld more"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld más"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ほか%lld件"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld개 더"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "还有 %lld 个"
          }
        }
      }
    },
    "%lld of %lld recorded. Open Maru to check the rest." : {
      "comment" : "The body of the notification after the Take All or Skip All action of a reminder recorded some doses and not all. The first placeholder is the number of doses recorded, the second is the number that the reminder names.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld von %lld erfasst. Öffne Maru, um den Rest zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld of %lld recorded. Open Maru to check the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld de %lld registradas. Abre Maru para revisar el resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld/%lld件を記録しました。残りはMaruを開いて確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld/%lld개를 기록했습니다. Maru를 열어 나머지를 확인해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已记录 %lld/%lld 项。打开 Maru 看看其余的。"
          }
        }
      }
    },
    "Maru could not save the dose. Open Maru to try again." : {
      "comment" : "The body of the notification after the Taken action of a reminder recorded nothing, because the record did not save.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru konnte die Einnahme nicht speichern. Öffne Maru und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru could not save the dose. Open Maru to try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru no pudo guardar la toma. Abre Maru para intentarlo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maruは記録を保存できませんでした。Maruを開いてもう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru가 기록을 저장하지 못했습니다. Maru를 열어 다시 시도해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru 没能保存这次记录。打开 Maru 再试一次。"
          }
        }
      }
    },
