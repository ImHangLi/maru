    "This reminder no longer matches one dose of today. Open Maru to record it." : {
      "comment" : "The body of the notification after the Taken action of a reminder recorded nothing, because the reminder does not match exactly one open dose of today.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Erinnerung passt nicht mehr zu genau einer Einnahme von heute. Öffne Maru, um sie zu erfassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This reminder no longer matches one dose of today. Open Maru to record it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este recordatorio ya no corresponde a una sola toma de hoy. Abre Maru para registrarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このリマインダーは、今日の1回分と一致しなくなりました。Maruを開いて記録してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 알림은 더 이상 오늘의 한 회분과 맞지 않습니다. Maru를 열어 기록해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这条提醒已不对应今天的某一次服用。打开 Maru 来记录。"
          }
        }
