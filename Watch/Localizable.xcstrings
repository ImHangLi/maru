    "Your iPhone did not confirm. Check Maru on your iPhone." : {
      "comment" : "Watch: shown after a tap when the request left the Watch and no answer came. The iPhone can have the record or not.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone hat nicht bestätigt. Prüfe Maru auf deinem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu iPhone no confirmó. Revisa Maru en tu iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneから確認が届きませんでした。iPhoneのMaruを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에서 확인을 받지 못했습니다. iPhone의 Maru를 확인하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone 未确认。请在 iPhone 上查看 Maru。"
          }
        }
      }
    },
    "Your iPhone is not reachable. Nothing was recorded." : {
      "comment" : "Watch: shown after a tap when the Watch cannot reach the iPhone. The dose stays open.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein iPhone ist nicht erreichbar. Es wurde nichts erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede conectar con tu iPhone. No se registró nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneに接続できません。何も記録されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhone에 연결할 수 없습니다. 기록된 내용이 없습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法连接 iPhone。未记录任何内容。"
          }
        }
      }
