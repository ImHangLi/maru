    "Not recorded" : {
      "comment" : "Watch: VoiceOver label of the gray capsule of a dose with no record yet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erfasst"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin registrar"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未記録"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록되지 않음"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没记录"
          }
        }
      }
    },
    "Not recorded. Open Maru on your iPhone." : {
      "comment" : "Watch: shown after a tap when the iPhone answered that it recorded nothing, for example because the plan of the dose changed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erfasst. Öffne Maru auf deinem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No registrado. Abre Maru en tu iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録されていません。iPhoneでMaruを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록되지 않았어요. iPhone에서 Maru를 열어 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没记录。去 iPhone 上打开 Maru。"
          }
        }
      }
    },
    "Not recorded. Unlock your iPhone and try again." : {
      "comment" : "Watch: shown after a tap when the iPhone answered that it recorded nothing and could not read its data. The usual cause: the iPhone restarted and was not unlocked yet.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erfasst. Entsperre dein iPhone und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No registrado. Desbloquea tu iPhone e inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録されていません。iPhoneのロックを解除して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록되지 않았어요. iPhone 잠금을 풀고 다시 시도해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没记录。解锁 iPhone 再试一次。"
          }
        }
      }
    },
    "Not taken" : {
