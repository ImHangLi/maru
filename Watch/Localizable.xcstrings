            "value" : "%@に服用"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복용 시간: %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 服用"
          }
        }
      }
    },
    "This dose changed on your iPhone. Nothing was recorded." : {
      "comment" : "Watch: shown after a tap when the dose on the iPhone is not the one that the Watch showed, for example after a change of its record on the iPhone. The Watch then shows the new list.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Dosis wurde auf deinem iPhone geändert. Es wurde nichts erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta dosis cambió en tu iPhone. No se registró nada."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この服用はiPhoneで変更されました。何も記録されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 복용이 iPhone에서 바뀌었어요. 기록된 내용은 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这次服用在 iPhone 上有变化，没有记录任何内容。"
          }
        }
      }
    },
