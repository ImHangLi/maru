    "Not recorded. Open Maru on your iPhone." : {
      "comment" : "Watch: shown after a tap when the iPhone answered that it recorded nothing, for example because the plan of the dose changed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erfasst. Öffne Maru auf deinem iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No registrado. Abre Maru en tu iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録されていません。iPhoneでMaruを開いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록되지 않음. iPhone에서 Maru를 여세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未记录。请在 iPhone 上打开 Maru。"
          }
        }
      }
    },
    "Not recorded. Unlock your iPhone and try again." : {
      "comment" : "Watch: shown after a tap when the iPhone answered that it recorded nothing and could not read its data, because it is locked.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht erfasst. Entsperre dein iPhone und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No registrado. Desbloquea tu iPhone e inténtalo de nuevo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "記録されていません。iPhoneのロックを解除して、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기록되지 않음. iPhone을 잠금 해제하고 다시 시도하세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未记录。请解锁 iPhone 后重试。"
          }
        }
      }
    },
    "Not taken" : {
