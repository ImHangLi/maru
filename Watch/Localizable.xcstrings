    "Taken at %@" : {
      "comment" : "Watch: the second line of a taken dose. %@ is the intake time, for example 8:07 AM. The same words as the row on the iPhone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eingenommen: %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomado: %@"
