    "Open Maru on your iPhone to update." : {
      "comment" : "Watch: shown when the Watch has no list of today from the iPhone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne Maru auf deinem iPhone zum Aktualisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre Maru en tu iPhone para actualizar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneでMaruを開いて更新してください。"
