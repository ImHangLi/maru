{
  "sourceLanguage" : "en",
  "strings" : {
    "Check my last dose in ${applicationName}" : {
      "comment" : "Siri phrase of \"Last Dose\" with no item. Siri then asks which item. Draft (D108).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeig meine letzte Dosis in ${applicationName}"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta mi última dosis en ${applicationName}"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "${applicationName}で前回の服用を確認"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
