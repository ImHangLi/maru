{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAlarmKitUsageDescription" : {
      "comment" : "The text of the system alarm permission prompt. The prompt shows at the first tap on the Alarm switch on the add and edit screen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru lässt zur Einnahmezeit eines Eintrags einen Wecker klingeln, wenn du für diesen Eintrag „Wecker“ aktivierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru rings an alarm at the dose time of an item when you turn on Alarm for that item."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru hace sonar una alarma a la hora de toma de un elemento cuando activas Alarma para ese elemento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "項目の「アラーム」をオンにすると、Maruはその項目の服用時刻にアラームを鳴らします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항목의 ‘알람’을 켜면 Maru가 그 항목의 복용 시간에 알람을 울려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为某个项目开启“闹钟”后，Maru 会在该项目的服用时间响铃。"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "The text of the system camera permission prompt. The prompt shows at the first tap on Scan Label or Take Photo.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru verwendet die Kamera, um den Namen auf einem Etikett zu lesen und ein Foto eines Eintrags aufzunehmen. Ein Etikett-Scan speichert kein Foto."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru uses the camera to read the name on a label and to take a photo of an item. A label scan saves no photo."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru usa la cámara para leer el nombre de una etiqueta y para hacer una foto de un elemento. El escaneo de una etiqueta no guarda ninguna foto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maruはカメラを使って、ラベルの名前を読み取ったり、項目の写真を撮ったりします。ラベルのスキャンでは写真を保存しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru는 카메라로 라벨의 이름을 읽고 항목 사진을 찍어요. 라벨 스캔은 사진을 저장하지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru 使用相机读取标签上的名称，并为项目拍照。扫描标签不会存储照片。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
