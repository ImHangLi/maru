    },
    "This is a preview. With Maru Pro, the whole app uses this color." : {
      "comment" : "Settings, footer of \"Display\": a free user chose an app color other than pink. Only the settings sheet shows it (D114).",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ist eine Vorschau. Mit Maru Pro nutzt die ganze App diese Farbe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es una vista previa. Con Maru Pro, toda la app usa este color."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはプレビューです。Maru Proなら、App全体がこのカラーになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
