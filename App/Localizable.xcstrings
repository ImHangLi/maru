    },
    "Quiet" : {
      "comment" : "Settings: notifications are delivered quietly to Notification Center, with no sound or banner."
    },
    "Record %@" : {
      "comment" : "VoiceOver label of the record circle of an open dose. Record means to write down that the dose was taken. The placeholder is the item name."
