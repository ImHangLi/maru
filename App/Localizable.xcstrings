    },
    "Archive %@?" : {
      "comment" : "The title of the archive confirmation. The placeholder is the item name."
    },
    "Archived" : {
      "comment" : "The state of an archived item in the item detail, and the title of the list of archived items."
    },
    "Archived items keep their records but get no reminders." : {
      "comment" : "Archived list: the footer of the list."
    },
    "Archive…" : {
      "comment" : "Today, My Items, and item detail: the menu button that asks to archive the item."
    },
    "As Needed" : {
      "comment" : "Today: the title of the section of items with no schedule. History: the second line of an item that the user takes only when needed. It is not a time of day."
    },
    "Back Up" : {
      "comment" : "Settings: the button that makes a backup file and opens the share sheet."
    },
