    "Maru found no single subject, so the photo stays as it is." : {
      "comment" : "Edit screen: the footer when the background removal found no subject or more than one. The plain crop stays.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru hat kein einzelnes Motiv gefunden. Das Foto bleibt unverändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru no ha encontrado un único sujeto, así que la foto se queda como está."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maruは被写体を1つに絞れなかったため、写真はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru가 하나의 피사체를 찾지 못해서 사진은 그대로예요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru 没有找到单一主体，所以照片保持原样。"
          }
        }
      }
    },
    "Share Usage Statistics" : {
      "comment" : "Settings: the switch for usage statistics.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzungsstatistik teilen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir estadísticas de uso"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "利用状況の統計を共有"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 통계 공유"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共享使用统计信息"
          }
        }
      }
    },
    "Maru shares how you use the app, and never item names, doses, or times." : {
      "comment" : "Settings: the footer of the usage statistics switch. One sentence.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru teilt, wie du die App nutzt, aber nie Namen, Dosen oder Zeiten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru comparte cómo usas la app, nunca nombres de elementos, dosis ni horas."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maruが共有するのは機能の利用状況だけです。項目名、用量、時刻は共有しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru는 앱 사용 정보만 공유해요. 항목 이름, 용량, 시간은 절대 공유하지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru 只共享功能使用情况，绝不包含项目名称、剂量或时间。"
          }
        }
      }
    },
    "Help Improve Maru?" : {
      "comment" : "The one-time question about usage statistics in the EU, the UK, and Switzerland: the title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru verbessern helfen?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres ayudar a mejorar Maru?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maruの改善にご協力いただけますか？"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru 개선에 도움을 주시겠어요?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要帮助改进 Maru 吗？"
          }
        }
      }
    },
