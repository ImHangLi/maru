    "Your change is saved, but the old reminder may still go off." : {
      "comment" : "Alert message after reminders off or archive when the system did not confirm that the old reminder is gone.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderung ist gespeichert, aber die alte Erinnerung kann noch auslösen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cambio se guardó, pero el recordatorio anterior aún puede sonar."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更は保存しましたが、以前のリマインダーがまだ通知される可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 내용은 저장했지만, 이전 미리 알림이 아직 울릴 수 있어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改已保存，但旧的提醒可能还会响。"
          }
        }
      }
    },
    "Your change is saved, but the reminder for this item isn’t set yet." : {
      "comment" : "Alert message after a save or a change when the reminder is not set. It says what went wrong and what did not get done.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Änderung ist gespeichert, aber die Erinnerung für diesen Eintrag ist noch nicht festgelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cambio se guardó, pero el recordatorio de este elemento aún no está programado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "変更は保存しましたが、この項目のリマインダーはまだ設定できていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변경 내용은 저장했지만, 이 항목의 미리 알림은 아직 설정되지 않았어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "修改已保存，但这个药品的提醒还没设好。"
          }
        }
      }
    },
    "Your data file is damaged. Maru left it exactly as it was." : {
      "comment" : "Storage problem: the text for a damaged data file. Maru did not touch the file.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Datendatei ist beschädigt. Maru hat sie genau so gelassen, wie sie war."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu archivo de datos está dañado. Maru lo dejó tal como estaba."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データファイルが破損しています。Maruはファイルに一切手を加えていません。"
