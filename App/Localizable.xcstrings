      }
    },
    "There’s no account to make and no ads. What you take is yours alone." : {
      "comment" : "Onboarding, page 2 (privacy): the line under the title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein Konto, keine Werbung. Was du nimmst, bleibt deine Sache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay cuenta que crear ni anuncios. Lo que tomas es solo tuyo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アカウント登録も広告もありません。何を飲んでいるかは、あなただけのものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계정을 만들 필요도, 광고도 없어요. 무엇을 복용하는지는 나만 알아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不用注册账户，也没有广告。你服用的内容只属于你。"
          }
        }
      }
    },
    "This change didn’t save. Please try again." : {
