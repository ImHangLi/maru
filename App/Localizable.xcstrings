{
  "sourceLanguage" : "en",
  "strings" : {
    "Choose Photo" : {
      "comment" : "Edit screen: the button that opens the photo library to pick a photo for the item."
    },
    "Maru couldn’t read this photo." : {
      "comment" : "Edit screen: the footer when the chosen file is not an image that Maru can read."
    },
    "Maru found no single subject, so the photo stays as it is." : {
      "comment" : "Edit screen: the footer when the background removal found no subject or more than one. The plain crop stays."
    },
    "Share Usage Statistics" : {
      "comment" : "Settings: the switch for usage statistics."
    },
    "Maru shares counts of what you use, and never item names, doses, or times." : {
      "comment" : "Settings: the footer of the usage statistics switch. One sentence."
    },
    "Help Improve Maru?" : {
      "comment" : "The one-time notice about usage statistics: the title."
    },
    "Share Statistics" : {
      "comment" : "Usage statistics notice in the EU, the UK, and Switzerland: the button that turns the statistics on."
    },
    "Not Now" : {
      "comment" : "Usage statistics notice in the EU, the UK, and Switzerland: the button that leaves the statistics off."
    },
    "Turn Off" : {
      "comment" : "Usage statistics notice: the button that turns the statistics off."
    },
    "Share counts of what you use, such as whether you recorded a dose. Never item names, doses, or times. You can change this in Settings." : {
      "comment" : "Usage statistics notice in the EU, the UK, and Switzerland: the message. The statistics are off until the user agrees."
    },
    "Maru shares counts of what you use, such as whether you recorded a dose. Never item names, doses, or times. You can turn this off in Settings." : {
      "comment" : "Usage statistics notice: the message. The statistics are on by default outside the EU, the UK, and Switzerland."
    },
    "Open Maru to record this dose." : {
      "comment" : "Widget: the prompt after a tap on a capsule that could not record. The system then opens the app."
    },
    "Photo" : {
      "comment" : "Edit screen: the VoiceOver label of the photo of the item."
    },
    "Photo (Optional)" : {
      "comment" : "Edit screen: the header of the section with the photo of the item."
    },
    "Reading the photo…" : {
      "comment" : "Edit screen: the status while Maru reads the chosen photo."
    },
    "Record a Dose" : {
      "comment" : "Widget: the name of the action of a tap on a capsule. It shows in Shortcuts."
    },
    "Dose" : {
      "comment" : "Widget action: the name of the dose parameter."
    },
    "%@ %@" : {
      "comment" : "Edit screen: a reminder time on the device with its days, when the kept zone of a medication is on another day. Example: Sun 6:00 PM."
    },
    "%@ %@ time" : {
      "comment" : "Today: the reminder time of a medication that keeps another time zone. Example: 9:00 AM Shanghai time."
    },
    "%@ %@ time (%@ here for now)" : {
      "comment" : "Edit screen: the times of a medication in its kept zone. Example: 9:00 AM Shanghai time (6:00 PM here for now). \"For now\" because a clock change in either zone can move the local time or day later."
    },
    "%@ Time" : {
      "comment" : "Edit screen: the label of a reminder time in the kept zone of a medication, for example Shanghai Time."
    },
    "%@ at %@, with no end date" : {
      "comment" : "Edit screen: the preview line. The first placeholder is the days, for example Every day. The second is the times.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@, with no end date"
          }
        }
      }
    },
    "%@, %lld of %lld taken" : {
      "comment" : "History: the VoiceOver value of the graph for the selected day. Example: Tuesday, August 18, 2 of 3 taken."
    },
    "%@, nothing planned" : {
      "comment" : "History: the VoiceOver value of the graph for a selected day with no planned dose. Example: Saturday, August 22, nothing planned."
    },
    "%lld changes not saved" : {
      "comment" : "Today and History: the banner of the events that are not saved yet. Example: 1 change not saved.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld change not saved"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld changes not saved"
                }
              }
            }
          }
        }
      }
    },
    "%lld changes not saved. Try Again" : {
      "comment" : "Today and History: the VoiceOver label of the banner that saves every unsaved event again.",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld change not saved. Try Again"
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "%lld changes not saved. Try Again"
                }
              }
            }
          }
        }
      }
    },
