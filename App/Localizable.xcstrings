      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ at %2$@, with no end date"
          }
        }
      }
    },
    "%@, %lld of %lld taken" : {
      "comment" : "History: the VoiceOver value of the graph for the selected day. Example: Tuesday, August 18, 2 of 3 taken."
    },
    "%@, nothing planned" : {
      "comment" : "History: the VoiceOver value of the graph for a selected day with no planned dose. Example: Saturday, August 22, nothing planned."
    },
