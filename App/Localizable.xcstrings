    "Green" : {
      "comment" : "Item form or color name: the text “Green”."
    },
    "History" : {
      "comment" : "The title of the History page, and the button on Today that opens it. It lists what the user took, not a medical history."
    },
    "History Changed" : {
      "comment" : "Alert title in History and its logs when the stored record is not the one that the page showed."
    },
    "If your iPhone is locked, unlock it and try again. Maru did not change or delete your data." : {
      "comment" : "Storage problem: the text when the data cannot be read now."
