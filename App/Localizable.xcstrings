    "This backup replaces all items and records in Maru. You can’t undo this." : {
      "comment" : "The message of the restore confirmation.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Backup ersetzt alle Einträge und Aufzeichnungen in Maru. Das kannst du nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta copia de seguridad reemplaza todos los elementos y registros de Maru. No se puede deshacer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このバックアップは、Maruのすべての項目と記録を置き換えます。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 백업은 Maru의 모든 항목과 기록을 교체해요. 이 동작은 되돌릴 수 없어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此备份会替换 Maru 中的所有项目和记录。此操作无法撤销。"
          }
        }
      }
    },
    "This file is not a Maru backup, or it is damaged. Your data did not change." : {
      "comment" : "Settings: the alert for a file that is not a backup or is damaged.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Datei ist kein Maru-Backup oder sie ist beschädigt. Deine Daten haben sich nicht geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este archivo no es una copia de seguridad de Maru o está dañado. Tus datos no han cambiado."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このファイルはMaruのバックアップではないか、破損しています。データは変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru 백업이 아니거나 손상된 파일이에요. 데이터는 바뀌지 않았어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件不是 Maru 备份，或已损坏。你的数据没有变化。"
          }
        }
      }
    },
    "This item changed. Check it, then try again." : {
      "comment" : "Alert message when the stored record is not the one that the page showed. The word item means the dose or the record.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Eintrag hat sich geändert. Prüfe ihn und versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
