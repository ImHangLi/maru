    "%@: %@" : {
      "comment" : "Two uses with one format. 1) The title of an alarm that names its items: the first placeholder is the reminder title, the second is the item names. Example: Time to take: Zinc and Vitamin D. 2) A dose name with its owner when the Family has several members: the first placeholder is the member, the second is the item name. Example: Mochi: Methimazole.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@"
          }
        },
        "en" : {
