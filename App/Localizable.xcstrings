    },
    "Maru reminds you on time, and one tap records each dose." : {
      "comment" : "Onboarding, page 1: the line under the title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru erinnert dich pünktlich, und ein Tippen erfasst jede Dosis."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru te avisa a tiempo, y con un toque registras cada dosis."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maruが時間どおりにお知らせ。タップひとつで毎回の服用を記録できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru가 제때 알려 드리고, 한 번 탭하면 복용이 기록돼요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maru 准时提醒你，点一下就能记下每次服用。"
          }
        }
      }
    },
    "Maru sets the reminders of the next 7 dose days each time you open it." : {
      "comment" : "Item detail: the footer of a plan that counts days (every other day, every few days, or days on and days off) when its reminders are set. iPhone has no repeating reminder for this plan, so Maru sets dated reminders at each open.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
