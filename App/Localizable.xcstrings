    "Free for %lld days, then %@ per year. Cancel anytime." : {
      "comment" : "Paywall of Maru Pro: the terms line under the plans for the yearly plan with a free trial. First the number of trial days, then the price of one year. Example: Free for 7 days, then $9.99 per year. Cancel anytime.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld Tage gratis, dann %2$@ pro Jahr. Jederzeit kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld días gratis, luego %2$@ al año. Cancela cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld日間無料、その後は年額%2$@。いつでもキャンセル可能。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld일 무료, 이후 연 %2$@. 언제든 취소 가능."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费 %1$lld 天，之后每年 %2$@。可随时取消。"
          }
        }
      }
    },
    "Free some storage, then try again. Your data is safe." : {
      "comment" : "Storage problem: the text when the disk is full.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib etwas Speicherplatz frei und versuche es erneut. Deine Daten sind sicher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Libera espacio y vuelve a intentarlo. Tus datos están a salvo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "空き容量を確保してから、もう一度お試しください。データは無事です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "저장 공간을 확보한 다음 다시 시도해 주세요. 데이터는 안전해요."
          }
        },
        "zh-Hans" : {
