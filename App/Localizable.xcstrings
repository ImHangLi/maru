    "A backup moves everything to a new iPhone. The files have your item names and records and are not encrypted, so share them only with people you trust." : {
      "comment" : "Settings: the footer of “Your Data”."
    },
    "A newer version of Maru made this backup. Update Maru, then try again. Your data did not change." : {
      "comment" : "Settings: the alert for a backup file from a newer version of the app."
    },
    "A newer version of Maru saved your data. Maru did not change or delete it." : {
      "comment" : "Storage problem: the text when a newer version of the app saved the data."
    },
    "Add" : {
      "comment" : "Add a Time sheet: the button that adds the picked time."
    },
    "Add Item" : {
      "comment" : "Today and My Items: the add button, and the button of the empty My Items."
    },
    "Add a Time" : {
      "comment" : "Edit screen: the text “Add a Time”."
    },
    "Add a time to save the amount." : {
      "comment" : "Edit screen: the footer of the amount when the item has an amount and no time. The amount belongs to the reminder plan."
    },
    "Adds a reminder time at %@." : {
      "comment" : "Edit screen: the VoiceOver hint of a time candidate of the smart completion, for example Evening. The placeholder is the time, for example 8:00 PM."
    },
    "Amount" : {
      "comment" : "Item detail: the label of the amount that the user typed."
