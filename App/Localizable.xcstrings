    "In iPhone Settings, choose a city for your time zone." : {
      "comment" : "Today: the text below the time zone title."
    },
    "Keep Editing" : {
      "comment" : "Edit screen: the text “Keep Editing”."
    },
    "Maru asks when you save an item with a time." : {
      "comment" : "Settings footer before the system asked for the notification permission."
    },
    "Maru Can’t Open Your Data" : {
      "comment" : "Storage problem: the title when the data file is damaged, or when the update of the data failed."
    },
    "Maru can’t open your records while your iPhone is locked. Unlock it, then try again." : {
      "comment" : "Alert message when the user taps a reminder while the iPhone is locked and Maru cannot read the records."
    },
    "Maru Can’t Read Your Data Right Now" : {
      "comment" : "Storage problem: the title when the data can be read later, for example after the user unlocks the device."
    },
    "Maru Can’t Use the Camera" : {
      "comment" : "Edit screen: the title of the alert when the camera is off for Maru."
    },
    "Maru Can’t Use Your Time Zone" : {
      "comment" : "Today: the title when the time zone of the device is an offset such as GMT+8 and not a city."
    },
    "Maru can’t use your time zone for reminders." : {
      "comment" : "Edit screen: the preview line when the device time zone is an offset and not a city."
    },
    "Maru checks again when you open it." : {
      "comment" : "Item detail footer and alert message: the system did not confirm the reminder change yet."
    },
    "Maru couldn’t confirm that your iPhone saved it. If your data looks wrong later, restore the backup again." : {
      "comment" : "Settings: the alert for a restore that replaced the data, when the storage did not confirm the save."
    },
    "Maru couldn’t make the file. Try again." : {
      "comment" : "Settings: the alert for a record export or a backup that failed."
    },
    "Maru couldn’t read the history." : {
      "comment" : "History: the footer of the error section when the days did not read, other than a locked iPhone."
    },
    "Maru couldn’t read this item." : {
      "comment" : "Item detail: the description under the title Can’t Show Item."
    },
    "Maru couldn’t restore this backup. Your data did not change." : {
      "comment" : "Settings: the alert for a restore that failed."
    },
    "Maru Couldn’t Save" : {
      "comment" : "Edit screen: the title of the alert when the item did not save. The message under it says that the entries are still on the screen."
    },
    "Maru couldn’t save this change. Try again." : {
      "comment" : "Item detail: the message when a change did not save."
    },
    "Maru couldn’t save this. Try again." : {
      "comment" : "Alert message when a record or a correction did not save. The word this means the change that the user just made."
    },
    "Maru deletes this item, its plan, and all its records. You can’t undo this." : {
      "comment" : "The message of the delete confirmation."
    },
    "Maru did not change or delete your data." : {
      "comment" : "Storage problem: the text for a failure with no known cause."
    },
    "Maru kept your unsaved changes." : {
      "comment" : "Edit screen: the text “Maru kept your unsaved changes.”."
    },
    "Maru reminds you up to %lld times for each dose, until %@ at the latest." : {
      "comment" : "Settings: the footer of “Until Recorded”. iPhone has no reminder that repeats with no end, so Maru states the limit. The first placeholder is the number 12. The second is the time of the next day at which the reminders of a dose stop, for example “1:00 AM”."
    },
    "Maru reads only the name." : {
      "comment" : "Label scan: the line under the prompt before the user taps a text. The scan reads no amount and no time."
    },
    "Maru sets the reminders of the next 7 dose days each time you open it." : {
      "comment" : "Item detail: the footer of a plan that repeats every second day when its reminders are set. iPhone has no repeating reminder for this plan, so Maru sets dated reminders at each open."
    },
    "Maru stops its reminders and hides it from Today and My Items. Your records stay. This is not advice to stop taking it." : {
      "comment" : "Message of the archive confirmation. The word it means the item that the title names. Archive hides an item, and the records stay."
    },
    "Maru tries again when you open it." : {
      "comment" : "Item detail: the footer of the plan when the reminder is not set yet."
    },
