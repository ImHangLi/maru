    "Couldn’t confirm the restore. If anything looks wrong later, restore the backup again." : {
      "comment" : "Settings, Your Data: the message when Maru could not confirm that the restored data is saved.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
