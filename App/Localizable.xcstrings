    },
    "%@ %@ time (%@ here for now)" : {
      "comment" : "Edit screen: the times of a medication in its kept zone. Example: 9:00 AM Shanghai time (6:00 PM here for now). \"For now\" because a clock change in either zone can move the local time or day later.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (Ortszeit %2$@), derzeit %3$@ hier"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hora de %2$@ (%3$@ aquí por ahora)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@時間 %1$@（現在ここでは%3$@）"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 시간 %1$@(현재 여기서는 %3$@)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@时间 %1$@（这里现在是 %3$@）"
          }
        }
      }
    },
    "%@ per year. Cancel anytime." : {
      "comment" : "Paywall of Maru Pro: the terms line under the plans for the yearly plan with no free trial. The price of one year. Example: $9.99 per year. Cancel anytime.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pro Jahr. Jederzeit kündbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ al año. Cancela cuando quieras."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年額%@。いつでもキャンセル可能。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "연 %@. 언제든 취소 가능."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每年 %@。可随时取消。"
          }
        }
