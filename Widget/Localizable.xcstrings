        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "남은 복용 횟수를 확인해요. 이름은 표시하지 않아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看还剩多少次服用。不显示名称。"
          }
        }
