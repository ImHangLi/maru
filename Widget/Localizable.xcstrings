    "See how many doses are left. It shows no names." : {
      "comment" : "Widget gallery: description of the Today widget.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh, wie viele Dosen noch offen sind. Es zeigt keine Namen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta cuántas dosis quedan. No muestra nombres."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "残りの服用数を確認できます。名前は表示されません。"
