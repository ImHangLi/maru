    "Tap a capsule to record a dose of the current slot." : {
      "comment" : "Widget gallery: description of the Take Now widget.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Kapsel, um eine Dosis des aktuellen Zeitfensters zu erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una cápsula para registrar una dosis del momento actual."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カプセルをタップすると、現在の時間帯の服用を記録します。"
